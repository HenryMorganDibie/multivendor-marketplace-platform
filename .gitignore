# Firebase emulator state
.firebase/

# Environment files
.env
.env.local
.env.*.local
*.env
# Firebase Functions v2's per-project convention (.env.<project-id>, e.g.
# .env.platform-dev) doesn't match any pattern above — none of them match a
# file that merely contains ".env" without starting or ending with it.
.env.*

# Service account keys — NEVER commit these
*-service-account*.json
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json

