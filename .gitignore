coverage/
.nyc_output/scripts/*-tmp.js
emu.log

# Generated during deploys; not source.
.deploy-targets

# Built web bundle copied here for hosting deploys — generated, not source.
webapp/

# Large reference data dump, not source.
scripts/geodata/
