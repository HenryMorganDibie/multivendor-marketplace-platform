{
  "name": "platform-functions",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"fs.cpSync('src/subscriptions/apple-certs', 'lib/subscriptions/apple-certs', { recursive: true })\" -r fs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@types/pdfkit": "^0.17.6",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^178.0.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "c8": "^11.0.0",
    "typescript": "^5.4.0"
  },
  "private": true
}
